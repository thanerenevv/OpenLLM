#!/usr/bin/env python3
"""openllm - pick a local model, tune it, run it (interactive terminal UI or headless).

Stdlib only until the UI dependencies are needed; see openllm_app/bootstrap.py.
  ./openllm          interactive dashboard
  ./openllm --last   start the last-used model without any UI
"""
import os
import sys
from pathlib import Path

ROOT = Path(os.path.realpath(__file__)).parent
sys.path.insert(0, str(ROOT))

from openllm_app import bootstrap  # noqa: E402
from openllm_app.__main__ import main  # noqa: E402

if __name__ == "__main__":
    try:
        if "--last" not in sys.argv:  # headless needs nothing beyond the stdlib
            bootstrap.ensure(ROOT, [str(ROOT / "openllm"), *sys.argv[1:]])
        sys.exit(main(sys.argv[1:], ROOT))
    except (KeyboardInterrupt, EOFError):
        print()
