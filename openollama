#!/usr/bin/env python3
"""openollama - pick a local model, tune it, run it (terminal chat or OpenAI-compatible API).

Models and runtimes live in models.json next to this file. Each runtime has an
adapter below that turns the chosen settings into a command line.
"""
import json
import os
import secrets
import subprocess
import sys
import tarfile
from pathlib import Path

ROOT = Path(os.path.realpath(__file__)).parent
REGISTRY = ROOT / "models.json"
STATE = ROOT / "state.json"
API_NAME_FALLBACK_KEY = "sk-local"


# --------------------------------------------------------------------------- ui
def ask(title, options, default=0):
    """Numbered menu. options = [(value, label)]. Enter picks the default."""
    print(f"\n{title}")
    for i, (_, label) in enumerate(options, 1):
        print(f"  {i}) {label}{'  [default]' if i - 1 == default else ''}")
    while True:
        raw = input("> ").strip()
        if not raw:
            return options[default][0]
        if raw.isdigit() and 1 <= int(raw) <= len(options):
            return options[int(raw) - 1][0]
        print("  pick a number from the list")


def ask_text(prompt, default):
    raw = input(f"{prompt} [{default}]: ").strip()
    return raw or str(default)


def parse_tokens(text):
    t = text.strip().lower().replace(",", "")
    mult = 1024 if t.endswith("k") else 1
    return int(float(t.rstrip("k")) * mult)


def human_ctx(n):
    return f"{n // 1024}K" if n % 1024 == 0 else str(n)


def die(msg):
    print(f"\nerror: {msg}", file=sys.stderr)
    sys.exit(1)


# ----------------------------------------------------------------------- state
def load_json(path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def save_state(state):
    STATE.write_text(json.dumps(state, indent=2))
    STATE.chmod(0o600)  # holds the API key


# ------------------------------------------------------------------- downloads
def curl(url, dest):
    cmd = ["curl", "-fL", "-C", "-", "--retry", "5", "--progress-bar", "-o", str(dest), url]
    if subprocess.call(cmd) != 0:
        die(f"download failed: {url} (re-run to resume)")


def runtime_dir(rt):
    return ROOT / rt["dir"].format(tag=rt["tag"])


def runtime_bin(rt, name):
    return runtime_dir(rt) / name


def ensure_runtime(rt_id, rt):
    if runtime_bin(rt, "llama-server").exists():
        return
    size = "~12 MB"
    if input(f"\nRuntime '{rt_id}' ({rt['tag']}, {size}) is not installed. Download it? [Y/n] ").strip().lower() == "n":
        die("runtime required")
    dest_dir = runtime_dir(rt)
    tmp = ROOT / ".dl"
    tmp.mkdir(exist_ok=True)
    archive = tmp / f"{rt_id}-{rt['tag']}.tar.gz"
    curl(rt["url"].format(tag=rt["tag"]), archive)
    with tarfile.open(archive) as tf:  # refuse path traversal before extracting
        for m in tf.getmembers():
            p = Path(m.name)
            if p.is_absolute() or ".." in p.parts:
                die(f"unsafe path in runtime archive: {m.name}")
    dest_dir.mkdir(parents=True, exist_ok=True)
    subprocess.check_call(["tar", "-xzf", str(archive), "-C", str(dest_dir), "--strip-components=1"])
    archive.unlink()


def model_path(m):
    return ROOT / "models" / m["file"]


def ensure_model(m):
    path = model_path(m)
    if path.exists():
        return
    if input(f"\nModel file {m['file']} (~{m['size_gb']} GB) is not downloaded. Download it? [Y/n] ").strip().lower() == "n":
        die("model required")
    path.parent.mkdir(exist_ok=True)
    part = path.with_name(path.name + ".part")
    curl(f"https://huggingface.co/{m['repo']}/resolve/main/{m['file']}", part)
    part.rename(path)


# ------------------------------------------------------------------ memory est
def total_ram_gb():
    try:
        return int(subprocess.check_output(["sysctl", "-n", "hw.memsize"])) / 2**30
    except (OSError, ValueError, subprocess.CalledProcessError):
        return 0.0


def estimate_gb(m, ctx, kv):
    """GiB on the GPU: weights + KV (measured per 1K tokens) + ~0.55 for recurrent state and compute buffers."""
    return m["weights_gib"] + m["kv_mib_per_1k"][kv] * (ctx / 1024) / 1024 + 0.55


def lan_ip():
    for iface in ("en0", "en1"):
        try:
            ip = subprocess.check_output(["ipconfig", "getifaddr", iface], text=True, stderr=subprocess.DEVNULL).strip()
            if ip:
                return ip
        except (OSError, subprocess.CalledProcessError):
            pass
    return "<your-mac-ip>"


# ------------------------------------------------------------------- settings
def choose_settings(m, prev):
    ram = total_ram_gb()
    gpu_budget = ram * 0.75 - 1.0  # Metal allows ~75% of RAM on the GPU; keep 1 GiB spare as llama.cpp does
    s = {}

    s["mode"] = ask("How do you want to run it?", [
        ("chat", "Terminal chat"),
        ("server", "OpenAI-compatible API server (for Cline, opencode, etc.)"),
    ], 1 if prev.get("mode") == "server" else 0)

    s["kv"] = ask("KV cache precision (lower = more context in RAM, slightly lower quality):", [
        ("f16", "f16  (best quality)"),
        ("q8_0", "q8_0 (half the memory, near-lossless)"),
        ("q4_0", "q4_0 (quarter the memory)"),
    ], ["f16", "q8_0", "q4_0"].index(prev.get("kv", "q8_0")))

    ctx_choices = [c for c in (8192, 16384, 32768, 65536, 131072) if c <= m["max_ctx"]]
    opts = []
    for c in ctx_choices:
        est = estimate_gb(m, c, s["kv"])
        flag = "  !! likely too big for this Mac" if est > gpu_budget else ""
        opts.append((c, f"{human_ctx(c):>5} ctx  ~{est:.1f} GB{flag}"))
    opts.append(("custom", "custom"))
    default_ctx = prev.get("ctx", 32768)
    di = ctx_choices.index(default_ctx) if default_ctx in ctx_choices else 2
    ctx = ask(f"Context length (this Mac: {ram:.0f} GB RAM, ~{gpu_budget:.1f} GB usable by the GPU):", opts, di)
    if ctx == "custom":
        ctx = parse_tokens(ask_text("Context tokens (e.g. 48k or 49152)", 32768))
    s["ctx"] = max(1024, min(ctx, m["max_ctx"]))

    s["effort"] = ask("Reasoning effort (medium = shorter thinking, xhigh = the model's default):",
                      [(e, e) for e in m["reasoning_efforts"]],
                      m["reasoning_efforts"].index(prev.get("effort", "medium")))

    if s["mode"] == "chat":
        s["max_tokens"] = int(ask_text("Max output tokens per reply (thinking counts; keep >=16384)", prev.get("max_tokens", 16384)))
    else:
        s["expose"] = ask("Who can reach the API?", [
            ("local", "This Mac only (127.0.0.1)"),
            ("lan", "Anyone on my network (0.0.0.0, API key required)"),
        ], 1 if prev.get("expose") == "lan" else 0)
        s["port"] = int(ask_text("Port", prev.get("port", 8080)))
    return s


# ---------------------------------------------------------------- llama adapter
def build_llama_cmd(rt, m, s, api_key):
    smp = m["sampling"]
    base = [
        "-m", str(model_path(m)), "-ngl", "99", "-fa", "on", "-c", str(s["ctx"]),
        "--cache-type-k", s["kv"], "--cache-type-v", s["kv"],
        "--temp", str(smp["temp"]), "--top-p", str(smp["top_p"]),
        "--top-k", str(smp["top_k"]), "--min-p", str(smp["min_p"]),
        "--jinja",
        "--chat-template-kwargs", json.dumps({"reasoning_effort": s["effort"]}),
    ]
    if s["mode"] == "chat":
        return [str(runtime_bin(rt, "llama-cli")), *base, "-n", str(s["max_tokens"])]
    host = "0.0.0.0" if s["expose"] == "lan" else "127.0.0.1"
    cmd = [str(runtime_bin(rt, "llama-server")), *base,
           "--host", host, "--port", str(s["port"]),
           "-np", "1",  # one slot, so the whole context belongs to the one client
           "--alias", s["model_id"]]
    if api_key:
        cmd += ["--api-key", api_key]
    return cmd


ADAPTERS = {"llama.cpp": build_llama_cmd}


# --------------------------------------------------------------- client snippets
def print_server_info(s, api_key):
    host = lan_ip() if s["expose"] == "lan" else "127.0.0.1"
    base = f"http://{host}:{s['port']}/v1"
    key = api_key or API_NAME_FALLBACK_KEY
    ctx = s["ctx"]
    oc = {
        "$schema": "https://opencode.ai/config.json",
        "provider": {"openollama": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "OpenOllama",
            "options": {"baseURL": base, "apiKey": key},
            "models": {s["model_id"]: {"name": s["model_name"], "limit": {"context": ctx, "output": min(16384, ctx // 2)}}},
        }},
        "model": f"openollama/{s['model_id']}",
    }
    print(f"""
================ OpenAI-compatible API ================
 Base URL : {base}
 API key  : {key}
 Model ID : {s['model_id']}
 Context  : {ctx} tokens (one request at a time)

 Cline  : Settings -> API Provider "OpenAI Compatible"
          Base URL / API Key / Model ID as above; set Context Window = {ctx}
 opencode: put this in opencode.json (project) or ~/.config/opencode/opencode.json:
{json.dumps(oc, indent=2)}
 curl   : curl {base}/chat/completions -H "Authorization: Bearer {key}" \\
            -H "Content-Type: application/json" \\
            -d '{{"model":"{s['model_id']}","max_tokens":16384,"messages":[{{"role":"user","content":"hi"}}]}}'

 Tip: it is a thinking model. Clients must allow large max_tokens (>=16384)
 or replies can come back empty. Ctrl+C here stops the server.
=======================================================
""", flush=True)


# ------------------------------------------------------------------------ main
def main():
    reg = load_json(REGISTRY, None)
    if not reg:
        die(f"cannot read {REGISTRY}")
    state = load_json(STATE, {})

    print("OpenOllama - local model launcher")
    model_id = ask("Choose a model:", [
        (i, f"{mm['name']}  [{mm['runtime']}]" + ("" if model_path(mm).exists() else "  (not downloaded)"))
        for i, mm in reg["models"].items()])
    m = reg["models"][model_id]
    rt = reg["runtimes"][m["runtime"]]
    ensure_runtime(m["runtime"], rt)
    ensure_model(m)

    prev = state.get(model_id, {})
    if "--last" in sys.argv and prev:
        s = prev
    else:
        s = choose_settings(m, prev)
    s["model_id"], s["model_name"] = model_id, m["name"]

    api_key = None
    if s["mode"] == "server" and s["expose"] == "lan":
        api_key = state.get("api_key") or "sk-" + secrets.token_urlsafe(24)
        state["api_key"] = api_key
    state[model_id] = {k: v for k, v in s.items() if k not in ("model_id", "model_name")}
    save_state(state)

    cmd = ADAPTERS[rt["adapter"]](rt, m, s, api_key)
    if s["mode"] == "server":
        print_server_info(s, api_key)
    else:
        print("\nStarting chat. Ctrl+C to stop.\n", flush=True)
    os.execv(cmd[0], cmd)


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, EOFError):
        print()
